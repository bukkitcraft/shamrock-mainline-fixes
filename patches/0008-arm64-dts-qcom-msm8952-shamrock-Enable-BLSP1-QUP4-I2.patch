From f3fe0873f647494e9d35848153915cf396caf14e Mon Sep 17 00:00:00 2001
From: bukkitcraft <bukkitcraft@proton.me>
Date: Thu, 15 Oct 2026 04:17:53 +0300
Subject: [PATCH 8/9] arm64: dts: qcom: msm8952-shamrock: Enable BLSP1 QUP4 I2C
 and sensors

---
 .../qcom/msm8952-generalmobile-shamrock.dts   | 63 +++++++++++++++++++
 1 file changed, 63 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/msm8952-generalmobile-shamrock.dts b/arch/arm64/boot/dts/qcom/msm8952-generalmobile-shamrock.dts
index b25da8d7e..2866c70ea 100644
--- a/arch/arm64/boot/dts/qcom/msm8952-generalmobile-shamrock.dts
+++ b/arch/arm64/boot/dts/qcom/msm8952-generalmobile-shamrock.dts
@@ -228,6 +228,48 @@ touchscreen@5d {
 	};
 };
 
+&blsp1_i2c4 {
+	status = "okay";
+
+	/* Bosch BMI160 Accelerometer + Gyroscope IMU */
+	imu@68 {
+		compatible = "bosch,bmi160";
+		reg = <0x68>;
+		pinctrl-0 = <&bmi160_int1_default &bmi160_int2_default>;
+		pinctrl-names = "default";
+		interrupt-parent = <&tlmm>;
+		interrupts = <42 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "INT1";
+		vdd-supply = <&pm8950_l17>;
+		vddio-supply = <&pm8950_l6>;
+		mount-matrix = "0", "1", "0",
+			       "1", "0", "0",
+			       "0", "0", "-1";
+	};
+
+	/* AKM AK09911 3-axis Electronic Compass / Magnetometer */
+	magnetometer@c {
+		compatible = "asahi-kasei,ak09911";
+		reg = <0x0c>;
+		pinctrl-0 = <&ak09911_default>;
+		pinctrl-names = "default";
+		vdd-supply = <&pm8950_l17>;
+		vid-supply = <&pm8950_l6>;
+		reset-gpios = <&tlmm 132 GPIO_ACTIVE_LOW>;
+		mount-matrix = "0", "-1", "0",
+			       "-1", "0", "0",
+			       "0", "0", "-1";
+	};
+
+	/* Lite-On LTR-559 / LTR-579 Ambient Light and Proximity Sensor */
+	light-sensor@53 {
+		compatible = "liteon,ltr559";
+		reg = <0x53>;
+		vdd-supply = <&pm8950_l17>;
+		vddio-supply = <&pm8950_l6>;
+	};
+};
+
 &mdss {
 	status = "okay";
 };
@@ -808,6 +850,27 @@ cam_sensor_vana_sleep: cam-sensor-sleep-state {
 		drive-strength = <2>;
 		bias-disable;
 	};
+
+	bmi160_int1_default: bmi160-int1-default-state {
+		pins = "gpio42";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	bmi160_int2_default: bmi160-int2-default-state {
+		pins = "gpio37";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	ak09911_default: ak09911-default-state {
+		pins = "gpio132";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
 };
 
 &sleep_clk {
-- 
2.55.0

